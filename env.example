NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
NEXT_PUBLIC_MF_APP_API_KEY=
NEXT_PUBLIC_WELCOME_ORGANIZATION_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GitHub OAuth client is served by mf-go mfCorePublicAuth.

# reCAPTCHA (optional). Leave empty or omit to skip captcha in local/dev.
# When both are set, the registration form shows the widget and /api/recaptcha/verify
# checks the token with Google before calling the Welcome Particular.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=your_sentry_project

# Email (Resend) Configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=no-reply@masterfabric.co
